# {{ ansible_managed }}
# Settings shared by every release of the Event Feedback Dashboard (read by efd.service)
SERVER_PORT={{ efd_port }}
APP_ENVIRONMENT={{ efd_environment }}
APP_DATA_DIR={{ efd_data_dir }}
JAVA_OPTS={{ efd_java_opts }}
SPRING_SECURITY_USER_PASSWORD="{{ efd_organiser_password | replace('\\', '\\\\') | replace('"', '\\"') }}"
